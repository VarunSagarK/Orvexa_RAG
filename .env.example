# ─────────────────────────────────────────────────────────────────
# ORVEXA — Environment Variables Template
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git. This file (.env.example) is safe to commit
# because it contains only placeholder values, never real secrets.
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Found in: supabase.com → your project → Settings → API

# Your project URL (safe to expose to frontend)
SUPABASE_URL=https://your-project-id.supabase.co

# Anon/public key — used in the frontend React app (safe to expose)
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used ONLY in the backend API. NEVER send to frontend.
# This key bypasses Row Level Security. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── OpenAI ────────────────────────────────────────────────────
# Found in: platform.openai.com → API keys

OPENAI_API_KEY=sk-your-openai-api-key-here

# ── API server ────────────────────────────────────────────────
# Port the Express server listens on locally
PORT=3000

# The URL of your frontend app (used for CORS)
# Local development:
FRONTEND_URL=http://localhost:5173
# Production (update when you deploy to Vercel):
# FRONTEND_URL=https://orvexa.vercel.app

# ── JWT ───────────────────────────────────────────────────────
# Supabase handles JWT signing — this is just used to verify tokens server-side.
# Same value as SUPABASE_ANON_KEY above (Supabase uses this as the JWT secret).
JWT_SECRET=your-supabase-jwt-secret-here

# ── App config ────────────────────────────────────────────────
# Environment: development | production
NODE_ENV=development

# Default building name shown in the AI system prompt
# Override per-request with the building_id from the user's JWT
DEFAULT_BUILDING_NAME=JINJU

# RAG settings
RAG_TOP_K_RETRIEVE=20
RAG_TOP_K_RERANK=5
RAG_CONFIDENCE_THRESHOLD=0.72
RAG_DAILY_QUERY_LIMIT=20
